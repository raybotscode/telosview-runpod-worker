# TelosView v2 Environment Variables
# Copy to .env and fill in values

# OpenRouter (for Gemini AI analysis)
TELOSVIEW_OPENROUTER_API_KEY=

# RunPod (for GPU processing)
RUNPOD_API_KEY=

# JWT Auth
JWT_SECRET=telosview-dev-secret-change-in-production

# Cloudflare R2 (for splat storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=telosview-splats

# Server
PORT=3457
